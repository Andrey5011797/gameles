--- !u!114 &911565245
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 911565240}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ecb12ffd8634874882ca9ecad835fb9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialog
  dialogPanel: {fileID: 1031741759}
  npcText: {fileID: 341451408}
  choiceButtons: {fileID: 887288690}
  playerInteractor: {fileID: 87828593}
  startDialogue: "\u041A\u0430\u0439. \u042F \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0442\u044B \u043F\u0440\u0438\u0434\u0451\u0448\u044C. \u0421\u043E\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C \u0422\u044D\u0440\u043D \u0443\u0448\u0451\u043B \u0432 \u0417\u0430\u0440\u043E\u0441\u0448\u0438\u0435 \u041F\u0443\u0441\u0442\u043E\u0448\u0438 \u0442\u0440\u0438 \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434. \u041E\u043D \u0438\u0441\u043A\u0430\u043B \xAB\u043E\u0441\u043E\u0431\u044B\u0439\xBB \u043A\u0430\u043C\u0435\u043D\u044C. \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u043E\u0447\u044C\u044E \u0432 \u0448\u0430\u0445\u0442\u0435 \u0432\u0438\u0434\u0435\u043B\u0438 \u0441\u0432\u0435\u0442."
  lightAnswer: "\u0422\u044B \u0434\u043E\u0431\u0440\u044B\u0439 \u044E\u043D\u043E\u0448\u0430. \u0411\u0435\u0440\u0435\u0433\u0438 \u0441\u0435\u0431\u044F. \u0418... \u0435\u0441\u043B\u0438 \u0441\u043D\u043E\u0432\u0430 \u0443\u0441\u043B\u044B\u0448\u0438\u0448\u044C \u0433\u043E\u043B\u043E\u0441\u0430, \u043D\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u0439 \u0438\u043C."
  shadowAnswer: "\u0412\u043E\u0442 10 \u043C\u043E\u043D\u0435\u0442. \u0422\u044B \u0441\u0442\u0430\u043B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u0440\u0430\u0433\u043C\u0430\u0442\u0438\u0447\u043D\u044B\u043C, \u041A\u0430\u0439."
